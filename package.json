{
  "name": "pocket-notes",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Pocket Notes with IndexedDB persistence, iOS/Capacitor support, optional Supabase sync, offline access and recovery.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-offline.mjs",
    "preview": "vite preview",
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test tests/*.test.ts",
    "test:build": "node --test tests/deployment.test.mjs",
    "check": "npm test && npm run build && npm run test:build"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@fontsource/patrick-hand": "5.2.6",
    "@supabase/supabase-js": "^2.117.1",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.3",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "jsdom": "^25.0.1",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
